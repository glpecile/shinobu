# Copy to .env.local and fill in what you have. All EXPO_PUBLIC_* values are
# inlined into the JS bundle at build time — restart the dev server (or
# rebuild) after changing any of them; a running Metro won't pick them up.
# Every variable is optional: features backed by a missing credential stay
# dark instead of erroring.

# NOTE: Trakt has no env credentials (plan 0034 R12) — connecting Trakt is
# always the in-app guided setup on the Connect screen (your own API app from
# https://trakt.tv/oauth/applications; docs/solutions/trakt-oauth-setup.md).

# ── Simkl ───────────────────────────────────────────────────────────────────
# Your own API app from https://simkl.com/settings/developer. PKCE public
# client (plan 0034 KTD-1): there is NO client secret — never add one here.
EXPO_PUBLIC_SIMKL_CLIENT_ID=

# ── AniList ──────────────────────────────────────────────────────────────────
# Implicit-grant client id from https://anilist.co/settings/developer (no
# secret). AniList pins ONE redirect URL per client, and it's per-PLATFORM
# because native and web use different redirects — do NOT reuse one client id
# for both, or native breaks (it redirects to the web URL, which iOS's auth
# session can't intercept). Optional: without either, the Connect screen falls
# back to its in-app form.
#
# WEB dev/build: register a client whose redirect URL is your web origin.
# The dev origin (http://localhost:8081) and the deployed origin need TWO
# different clients — put each id in the NODE_ENV-scoped file Expo picks up
# automatically, NOT here in .env.local (a localhost id here gets baked into
# `deploy:web` and production redirects to localhost):
#   .env.development.local → localhost client   (used by `expo start`)
#   .env.production.local  → deployed-origin client (used by `expo export`)
EXPO_PUBLIC_ANILIST_CLIENT_ID=
# NATIVE dev/build: register a SEPARATE client whose redirect URL is exactly
# shinobu://redirect (the app's custom scheme — the only thing native OAuth can
# catch):
EXPO_PUBLIC_ANILIST_NATIVE_CLIENT_ID=

# ── TMDB ─────────────────────────────────────────────────────────────────────
# "API Read Access Token" (the long v4 Bearer token, NOT the short v3 key)
# from https://www.themoviedb.org/settings/api. Powers the person pages
# (cast/crew details + filmographies). Without it, person cards on the
# details screen are not pressable.
EXPO_PUBLIC_TMDB_TOKEN=
