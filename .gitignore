# typescript
*.tsbuildinfo
# src/uniwind-types.d.ts is generated by uniwind's bundler integration but is
# committed on purpose: CI's typecheck needs it and can't boot Metro to
# regenerate it. If themes change, the dev server rewrites it — commit the diff.
# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# wrangler local state/cache (see wrangler.jsonc — Cloudflare Workers web deploy)
.wrangler/

# Argent (@swmansion/argent) — installed in `--global` mode, but its `init`
# still writes project-local MCP config for every editor it detects. Only the
# vendored skills are committed (they follow AGENTS.md § Compound Knowledge:
# `.agents/skills/` + `skills-lock.json`); the per-editor server config and the
# tool auto-approve allowlist are per-machine setup, like settings.local.json.
.mcp.json
.claude/settings.json
.claude/rules/
.claude/agents/
.cursor/
.vscode/
.zed/
.gemini/
