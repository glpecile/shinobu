  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.14",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.73.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.112.0"
  },
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android.clean": "expo prebuild --platform android --clean && bun android",
    "ios": "expo run:ios",
    "ios.clean": "expo prebuild --platform ios --clean && bun ios",
    "clean": "expo prebuild --clean && expo run:android --no-bundler && expo run:ios",
    "web": "expo start --web",
    "dev:worker": "wrangler dev",
    "test": "bun test --isolate",
    "check:classnames": "bun scripts/check-classnames.ts",
    "check:router-push": "bun scripts/check-router-push.ts",
    "check:links": "bun scripts/check-external-urls.ts",
    "release:bump": "bun scripts/bump-version.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "build:web": "expo export --platform web --clear && cp 'dist/+not-found.html' dist/404.html",
    "deploy:web": "bun run build:web && wrangler deploy"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-fetch"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
