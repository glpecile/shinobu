{
  "name": "shinobu",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/ui": "~58.0.23",
    "@hookform/resolvers": "^5.9.1",
    "@legendapp/list": "^3.6.0",
    "@nandorojo/galeria": "^3.1.0",
    "@react-native-vector-icons/ionicons": "^13.1.5",
    "@swmansion/react-native-bottom-sheet": "0.17.1",
    "@tanstack/query-sync-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cn": "^0.3.3",
    "effect": "^4.0.4",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "nitro-webview": "github:l2hyunwoo/nitro-webview#275e9185a7d969ec08e96368d3825db70e796acb",
    "pressto": "^0.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-fetch": "^1.8.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "sonner": "^2.0.8",
    "sonner-native": "^0.27.0",
    "tailwindcss": "~4.3.3",
    "torph": "^0.1.3",
    "uniwind": "~1.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.3",
    "@shadcn/lint": "^0.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "happy-dom": "^20.14.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.150.0"
  },
  "private": true,
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "scripts": {
    "postinstall": "uniwind generate-artifacts --css src/global.css --dts src/uniwind-types.d.ts",
    "start": "expo start",
    "android": "expo run:android",
    "android.clean": "expo prebuild --platform android --clean && bun android",
    "ios": "expo run:ios",
    "ios.clean": "expo prebuild --platform ios --clean && bun ios",
    "clean": "expo prebuild --clean && expo run:android --no-bundler && expo run:ios",
    "web": "expo start --web",
    "dev:worker": "mkdir -p dist && wrangler dev",
    "test": "bun test --isolate",
    "check:classnames": "bun scripts/check-classnames.ts",
    "check:router-push": "bun scripts/check-router-push.ts",
    "check:links": "bun scripts/check-external-urls.ts",
    "release:bump": "bun scripts/bump-version.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "build:web": "expo export --platform web --clear --max-workers 2 && cp 'dist/+not-found.html' dist/404.html",
    "deploy:web": "bun run build:web && wrangler deploy"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-fetch"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "trustedDependencies": [
    "nitro-webview"
  ]
}
